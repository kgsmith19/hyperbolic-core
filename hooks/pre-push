#!/bin/sh
# hooks/pre-push -- OI-030: gate a push to main with the coverage floors
# BEFORE it leaves this machine, so red commits never reach CI in the first
# place. Design rationale: see git history for OI-030 (its OPEN-ISSUES.md
# ledger entry predates the move to GitHub issues and no longer exists).
#
# Not installed by git on its own -- runbox/install-pre-push-gate.ps1 (an
# untracked, Kyle-run-only script, same convention as every other
# runbox/*.ps1) copies this tracked file into .git/hooks/pre-push.
#
# Contract, mirroring hooks/lane.mjs's launch-cap shim: refuse the push ONLY
# on an explicit, deliberate covgate FAIL verdict for a push targeting main.
# On ANY other condition -- a feature-branch push, node missing, covgate
# itself crashing -- fail OPEN and let the push proceed. A bug in this gate
# must never lock Kyle out of pushing; `git push --no-verify` is also always
# available as the standard, visible bypass (git's own behavior, not
# something this script implements or can prevent).
#
# git feeds this script one stdin line per ref being pushed:
#   <local ref> <local sha1> <remote ref> <remote sha1>
# "remote ref" is the ref on the REMOTE this push updates -- that's the one
# that decides whether main is the destination, not the local branch name.

REPO_ROOT="$(git rev-parse --show-toplevel)" || {
  echo "pre-push: could not resolve repo root -- coverage gate SKIPPED (fail-open), push proceeding" >&2
  exit 0
}

EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
REFUSE=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue

  # Only gate pushes whose destination is refs/heads/main -- feature/PR
  # branches are a no-op, no added latency.
  if [ "$remote_ref" != "refs/heads/main" ]; then
    continue
  fi

  # Deleting the ref (local_sha all-zero) -- nothing to gate.
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac

  old="$remote_sha"
  case "$old" in
    0000000000000000000000000000000000000000) old="$EMPTY_TREE" ;; # brand-new ref
  esac

  if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: node not found on PATH -- coverage gate SKIPPED (fail-open), push proceeding" >&2
    continue
  fi

  OUT="$(cd "$REPO_ROOT" && ACC_COVGATE_RANGE="$old $local_sha" node hooks/covgate.mjs 2>&1)"
  CODE=$?
  echo "$OUT"

  if [ "$CODE" -ne 0 ]; then
    if printf '%s' "$OUT" | grep -q 'covgate: FAIL'; then
      echo "pre-push: covgate refused this push to main (see FAIL lines above). Use 'git push --no-verify' to bypass in an emergency." >&2
      REFUSE=1
    else
      echo "pre-push: coverage gate did not run cleanly (unexpected error, not a coverage verdict) -- fail-open, push proceeding" >&2
    fi
  fi
done

exit "$REFUSE"
