# =========================================================
# Deep Search Configuration
# =========================================================
# Deep Search runs free by default: local FastEmbed ranking plus keyless
# academic, community, video, archive, and web connectors.
#
# Optional keys below expand search to commercial web / external LLMs:

# Brave Search API Key (for web searches beyond academic repos)
BRAVE_SEARCH_API_KEY=

# OpenAI API Key (optional: for GPT-4o-mini in Full AI Brief mode)
OPENAI_API_KEY=

# SearXNG Endpoint URL (optional: for self-hosted metasearch instances)
SEARXNG_URL=http://127.0.0.1:8080

# Local SLM Endpoint (optional: for Ollama / LM-Studio on localhost)
LOCAL_LLM_URL=http://127.0.0.1:11434/v1

# Semantic Scholar API key (optional: higher rate limits for paper search)
SEMANTIC_SCHOLAR_API_KEY=

# Set to 1 to skip Wayback Machine fallbacks for failed fetches
DEEPSEARCH_DISABLE_WAYBACK=
