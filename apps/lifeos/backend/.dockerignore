# Whitelist: only what the image build needs may enter the build context,
# so secrets like .env can never leak into a layer.
*
!pyproject.toml
!src
!db
# The one-time Needs Me migration's three modules only, never the rest of scripts/.
!scripts
scripts/*
!scripts/__init__.py
!scripts/type_redefinition.py
!scripts/migrate_intention_needs_me.py
