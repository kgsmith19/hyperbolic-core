# Public client configuration. Copy this file to .env for local development.
# VITE_ values are compiled into the browser bundle; never add a secret.

# ADR-03: the toolbelt Supabase project (woltgcggxaehtuypkxqk) is the
# platform IdP. The URL and publishable/anon key are public by design (see
# apps/toolbelt/config.mjs's own comment) and are baked in as defaults in
# src/lib/session.ts, so these are only needed to point the Shell at a
# different project (e.g. a local/test project).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ACC's loopback API base (docs/planning/05-b-acc.md section 5). Defaults to
# http://127.0.0.1:43117, the documented port. Override only for a
# non-default local ACC instance.
VITE_ACC_API=

# LifeOS backend base for the Settings "unit health" row's GET /healthz
# check (apps/lifeos/backend/src/api/main.py). Defaults to same-origin
# /life/api, the production topology (docs/planning/05-a-hyperbolic-core.md
# section 4). Override for local dev against a directly-running LifeOS
# backend, e.g. http://127.0.0.1:8000.
VITE_LIFEOS_API=
