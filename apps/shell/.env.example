# Public client configuration. Copy this file to .env for local development.
# VITE_ values are compiled into the browser bundle; never add a secret.

# The local platform service (services/platform-api, #508) is the IdP and data
# API: owner decision 2026-10-29, local-only. src/lib/session.ts defaults to
# http://127.0.0.1:8400; set these only for a platform on another address.
# The anon key is the PLATFORM_ANON_KEY `cli.ts init` wrote (optional).
VITE_PLATFORM_URL=
VITE_PLATFORM_ANON_KEY=

# ACC's loopback API base (docs/planning/05-b-acc.md section 5). Defaults to
# http://127.0.0.1:43117, the documented port. Override only for a
# non-default local ACC instance.
VITE_ACC_API=

# LifeOS backend base for the Settings "unit health" row's GET /healthz
# check (apps/lifeos/backend/src/api/main.py). Defaults to same-origin
# /life/api, the production topology (docs/planning/05-a-hyperbolic-core.md
# section 4). Override for local dev against a directly-running LifeOS
# backend, e.g. http://127.0.0.1:8000.
VITE_LIFEOS_API=

# Idea Intake's submit endpoint (m3-06/m3-07, services/llm-handler's
# POST /api/intake/submit, src/lib/intake.ts). Defaults to same-origin
# /api/intake, the production topology (docs/ops/tailscale-serve-apply.sh's
# /api/ mount). Override for local dev against a directly-running Handler A,
# e.g. http://127.0.0.1:8200/api/intake.
VITE_INTAKE_API=

# The Brain's HTTP + SSE API (m4-14, services/brain/src/config.ts's
# BRAIN_PORT default). Defaults to the loopback dev port 8100 -- services/brain
# has no deployed production mount yet (m4-21, still pending), so unlike
# VITE_INTAKE_API this has no same-origin default to fall back to. Override
# once m4-21 lands a real topology, or for a directly-running local daemon.
VITE_BRAIN_API=
